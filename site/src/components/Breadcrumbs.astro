---
import T from './T.astro';
import L from './L.astro';
import { url } from '../lib/data';
interface Crumb { href?: string; label?: string; fi?: string; sv?: string; en?: string }
interface Props { trail: Crumb[] }
---
<nav class="crumbs" aria-label="Murupolku">
  <ol>
    <li><a href={url()}><T k="home" /></a></li>
    {Astro.props.trail.map((c) => (
      <li>
        {c.href
          ? <a href={c.href}>{c.label ?? <L fi={c.fi!} sv={c.sv} en={c.en} />}</a>
          : <span aria-current="page">{c.label ?? <L fi={c.fi!} sv={c.sv} en={c.en} />}</span>}
      </li>
    ))}
  </ol>
</nav>
