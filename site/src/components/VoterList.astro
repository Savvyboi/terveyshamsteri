---
// How each member voted in one named vote: the voters on each side, linked to their pages
// when the name matches someone at the meeting.
import T from './T.astro';
import PartyTag from './PartyTag.astro';
import { personUrl, voterOf, type Meeting, type Vote } from '../lib/data';
interface Props { m: Meeting; v: Vote }
const { m, v } = Astro.props;
const sides = (['jaa', 'ei', 'tyhja', 'poissa'] as const).filter((s) => v.names?.[s]?.length);
const voters = (s: string) => (v.names![s] ?? []).map((n) => ({ n, p: voterOf(m, n) }))
  .sort((a, b) => (a.p?.name ?? a.n).localeCompare(b.p?.name ?? b.n, 'fi'));
---
{sides.length > 0 ? (
  <details class="voters" open>
    <summary><T k="howVoted" /></summary>
    <div class="voter-sides">
      {sides.map((s) => (
        <div class={`voter-side side-${s}`}>
          <h4><i class={`dot seg-${s}`}></i><T k={s} /> <span class="note">({v.names![s].length})</span></h4>
          <ul>
            {voters(s).map(({ n, p }) => (
              <li>{p ? <a href={personUrl(m.region, p)}>{p.name}</a> : n}{p?.elected && <> <PartyTag party={p.elected.party} /></>}</li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </details>
) : (
  <p class="note"><T k="noVoterNames" /></p>
)}
