---
// One UI string in every language; CSS shows the reader's choice.
import { S, type Key } from '../lib/i18n';
interface Props { k: Key }
const s = S[Astro.props.k] as { fi: string; sv: string; en?: string };
---
<span class="fi" lang="fi" data-pagefind-ignore>{s.fi}</span><span class="sv" lang="sv" data-pagefind-ignore>{s.sv}</span>{s.en && s.en !== s.fi && <span class="en" lang="en" data-pagefind-ignore>{s.en}</span>}
