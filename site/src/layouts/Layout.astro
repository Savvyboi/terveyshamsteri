---
import '../styles/global.css';
import T from '../components/T.astro';
import Hamster from '../components/Hamster.astro';
import { IS_SAMPLE, load, url } from '../lib/data';
import { S, type Key } from '../lib/i18n';

interface Props { title?: string; titleSv?: string; description?: string; wide?: boolean; feed?: string }
const { title, description, feed } = Astro.props;
const fullTitle = title ? `${title} – Terveyshamsteri` : `Terveyshamsteri – ${S.tagline.fi}`;
const updated = load().status.updated_at;
const path = Astro.url.pathname;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const nav: { href: string; k: Key }[] = [
  { href: url(), k: 'overview' },
  { href: url('alueet'), k: 'regions' },
  { href: url('kokoukset'), k: 'meetings' },
  { href: url('aanestykset'), k: 'votes' },
  { href: url('aiheet'), k: 'topics' },
  { href: url('aloitteet'), k: 'initiatives' },
  { href: url('valtuutetut'), k: 'councillors' },
  { href: url('puolueet'), k: 'parties' },
  { href: url('aluevaalit-2025'), k: 'election' },
  { href: url('talous'), k: 'finances' },
  { href: url('vertailu'), k: 'compare' },
  { href: url('tietoa'), k: 'about' },
];
const current = (href: string) => (href === url() ? path === href : path.startsWith(href)) ? 'page' : undefined;
---
<!doctype html>
<html lang="fi" data-lang="fi">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{fullTitle}</title>
  <meta name="description" content={description ?? S.heroLead.fi} />
  <meta name="color-scheme" content="light dark" />
  <meta name="theme-color" content="#f6f3ec" />
  <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
  {feed && <link rel="alternate" type="application/rss+xml" title={fullTitle} href={feed} />}
  <meta property="og:title" content={fullTitle} />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Terveyshamsteri" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Newsreader:opsz,wght@6..72,600;6..72,700&display=swap" rel="stylesheet" />
  <script is:inline src={`${base}/boot.js`}></script>
</head>
<body>
  <a class="skip" href="#main"><T k="skip" /></a>
  <header class="site-header">
    <div class="wrap header-inner">
      <a class="brand" href={url()}>
        <Hamster size={40} />
        <span class="brand-name">Terveyshamsteri</span>
      </a>
      <nav class="nav" aria-label="Päävalikko">
        {nav.map((n) => <a href={n.href} aria-current={current(n.href)}><T k={n.k} /></a>)}
      </nav>
      <div class="tools">
        <button type="button" class="tool menu-button" aria-expanded="false" aria-controls="menu-panel"><T k="menu" /></button>
        <button type="button" class="tool theme-button" data-theme-toggle aria-label="Teema">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="4.5"/><path d="M12 2v2.5M12 19.5V22M2 12h2.5M19.5 12H22M4.9 4.9l1.8 1.8M17.3 17.3l1.8 1.8M4.9 19.1l1.8-1.8M17.3 6.7l1.8-1.8"/></svg>
          <span class="theme-label"></span>
        </button>
        <select class="tool" data-lang-select aria-label="Kieli / Språk / Language">
          <option value="fi" lang="fi">Suomi</option>
          <option value="sv" lang="sv">Svenska</option>
          <option value="en" lang="en">English</option>
        </select>
        <button type="button" class="tool" data-search-open><T k="search" /> <kbd>Ctrl K</kbd></button>
      </div>
    </div>
    {/* site.js copies the links from .nav when the menu first opens */}
    <div class="menu-panel" id="menu-panel">
      <nav class="wrap" aria-label="Valikko">
        <ul></ul>
      </nav>
    </div>
  </header>
  {IS_SAMPLE && <div class="sample-banner"><div class="wrap"><T k="sampleBanner" /></div></div>}
  <main id="main" class="wrap">
    <slot />
  </main>
  <footer class="site-footer">
    <div class="wrap footer-grid">
      <div>
        <p class="footer-brand"><Hamster size={26} /> Terveyshamsteri</p>
        <p><T k="disclaimer" /></p>
      </div>
      <div>
        <p><T k="updateWeekly" />{updated && <> <T k="lastUpdated" />: <time datetime={updated}>{new Date(updated).toLocaleDateString('fi-FI')}</time>.</>}</p>
        <p><a href={url('tietoa')}><T k="about" /></a> · <a href={url('haku')}><T k="search" /></a> · <a href={url('avoin-data')}><T k="openData" /></a> · <a href="https://github.com/Savvyboi/terveyshamsteri">GitHub</a> · <a href="https://savvyboi.github.io/vahtikissa/">Vahtikissa</a></p>
      </div>
    </div>
  </footer>
  <dialog class="search-dialog" aria-label="Haku">
    <div class="dialog-head">
      <p><T k="searchHint" /></p>
      <button type="button" class="tool" data-search-close><T k="close" /></button>
    </div>
    <div class="dialog-body"><div id="search-modal" class="pf"></div></div>
  </dialog>
  <script is:inline src={`${base}/site.js`} defer></script>
</body>
</html>
