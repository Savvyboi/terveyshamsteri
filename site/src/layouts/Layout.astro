---
import '../styles/global.css';
import T from '../components/T.astro';
import Hamster from '../components/Hamster.astro';
import { IS_SAMPLE, load, url } from '../lib/data';
import { S } from '../lib/i18n';

interface Props { title?: string; titleSv?: string; description?: string; wide?: boolean }
const { title, titleSv, description, wide } = Astro.props;
const fullTitle = title ? `${title} – Terveyshamsteri` : `Terveyshamsteri – ${S.tagline.fi}`;
const updated = load().status.updated_at;
const path = Astro.url.pathname;
const active = (p: string) => (path.startsWith(url(p)) ? 'page' : undefined);
---
<!doctype html>
<html lang="fi" data-lang="fi">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{fullTitle}</title>
  <meta name="description" content={description ?? S.heroLead.fi} />
  <link rel="icon" href={`${import.meta.env.BASE_URL}favicon.svg`} type="image/svg+xml" />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:type" content="website" />
  <script is:inline>
    // Pick the UI language: ?lang= > saved choice > browser language. Default Finnish.
    (function () {
      var q = new URLSearchParams(location.search).get('lang');
      var saved = null;
      try { saved = localStorage.getItem('lang'); } catch (e) {}
      var lang = q || saved || ((navigator.language || '').slice(0, 2) === 'sv' ? 'sv' : 'fi');
      if (lang !== 'sv') lang = 'fi';
      document.documentElement.dataset.lang = lang;
      document.documentElement.lang = lang;
    })();
  </script>
</head>
<body>
  <a class="skip" href="#main"><T k="skip" /></a>
  <header class="site-header">
    <div class="wrap header-inner">
      <a class="brand" href={url()}>
        <Hamster size={44} />
        <span class="brand-text">
          <span class="brand-name">Terveyshamsteri</span>
          <span class="brand-tag"><T k="tagline" /></span>
        </span>
      </a>
      <div class="lang-switch" role="group" aria-label="Kieli / Språk">
        <button type="button" data-set-lang="fi" lang="fi" aria-label="Suomeksi"><span class="long">Suomeksi</span><span class="short">FI</span></button>
        <button type="button" data-set-lang="sv" lang="sv" aria-label="På svenska"><span class="long">På svenska</span><span class="short">SV</span></button>
      </div>
    </div>
    <nav class="main-nav" aria-label="Päävalikko">
      <div class="wrap">
        <a href={url()} aria-current={path === url() ? 'page' : undefined}><T k="regions" /></a>
        <a href={url('haku')} aria-current={active('haku')}><T k="search" /></a>
        <a href={url('tietoa')} aria-current={active('tietoa')}><T k="about" /></a>
      </div>
    </nav>
  </header>
  {IS_SAMPLE && <div class="sample-banner"><div class="wrap"><T k="sampleBanner" /></div></div>}
  <main id="main" class:list={['wrap', { wide }]}>
    <slot />
  </main>
  <footer class="site-footer">
    <div class="wrap footer-grid">
      <div>
        <p class="footer-brand"><Hamster size={28} /> Terveyshamsteri</p>
        <p><T k="disclaimer" /></p>
      </div>
      <div>
        <p><T k="updateWeekly" />{updated && <> <T k="lastUpdated" />: <time datetime={updated}>{new Date(updated).toLocaleDateString('fi-FI')}</time>.</>}</p>
        <p><a href={url('tietoa')}><T k="about" /></a> · <a href="https://github.com/Savvyboi/terveyshamsteri">GitHub</a></p>
      </div>
    </div>
  </footer>
  <script is:inline>
    document.querySelectorAll('[data-set-lang]').forEach(function (b) {
      b.addEventListener('click', function () {
        var lang = b.getAttribute('data-set-lang');
        document.documentElement.dataset.lang = lang;
        document.documentElement.lang = lang;
        try { localStorage.setItem('lang', lang); } catch (e) {}
        document.dispatchEvent(new CustomEvent('langchange', { detail: lang }));
      });
    });
    // Attributes cannot hold two languages, so swap them in place.
    function applyAttrs() {
      var lang = document.documentElement.dataset.lang;
      document.querySelectorAll('[data-fi-placeholder]').forEach(function (el) {
        el.setAttribute('placeholder', el.getAttribute('data-' + lang + '-placeholder'));
      });
      document.querySelectorAll('[data-set-lang]').forEach(function (b) {
        b.setAttribute('aria-pressed', String(b.getAttribute('data-set-lang') === lang));
      });
    }
    applyAttrs();
    document.addEventListener('langchange', applyAttrs);
    // Copy buttons
    document.querySelectorAll('[data-copy]').forEach(function (b) {
      b.addEventListener('click', function () {
        var el = document.getElementById(b.getAttribute('data-copy'));
        if (!el || !navigator.clipboard) return;
        navigator.clipboard.writeText(el.textContent.trim()).then(function () {
          b.classList.add('done');
          setTimeout(function () { b.classList.remove('done'); }, 1600);
        });
      });
    });
  </script>
</body>
</html>
