---
import Layout from '../layouts/Layout.astro';
import T from '../components/T.astro';
import L from '../components/L.astro';
import Hamster from '../components/Hamster.astro';
import MeetingTable from '../components/MeetingTable.astro';
import VoteTable from '../components/VoteTable.astro';
import { fmtDate, load, url } from '../lib/data';

const { regions, meetings, bodies, status } = load();
const enabled = regions.filter((r) => r.enabled && r.meetings > 0);
const items = meetings.reduce((a, m) => a + m.items.length, 0);
const allVotes = meetings.flatMap((m) => m.items.flatMap((it, i) => it.votes.map((v) => ({ m, i, v }))));
const bodyCount = [...bodies.values()].reduce((a, bs) => a + bs.length, 0);
const minutes = meetings.filter((m) => m.stage !== 'agenda');
const upcoming = meetings.filter((m) => m.stage === 'agenda').slice(0, 6).reverse();
const fi = (n: number) => n.toLocaleString('fi-FI');
const updated = status.updated_at ? fmtDate(status.updated_at.slice(0, 10)) : null;
---
<Layout>
  <section class="hero">
    <div>
      <p class="kicker"><T k="kicker" /></p>
      <h1><T k="heroTitle" /></h1>
      <p class="lead"><T k="heroLead" /></p>
      <form class="searchbox" action={url('haku')} method="get" role="search">
        <label for="q" class="sr-only"><T k="search" /></label>
        <input id="q" name="q" type="search" autocomplete="off"
          placeholder="Hae päätöksistä, esim. terveysasema"
          data-fi-placeholder="Hae päätöksistä, esim. terveysasema"
          data-sv-placeholder="Sök bland beslut, t.ex. hälsostation"
          data-en-placeholder="Search decisions, e.g. terveysasema" />
        <button class="btn" type="submit"><T k="search" /></button>
      </form>
    </div>
    <div class="hero-card">
      <div class="hero-art"><Hamster size={150} /></div>
      <div>
        <p class="hero-num">{fi(items)}</p>
        <p><T k="heroStat" /></p>
      </div>
    </div>
  </section>

  <p class="freshness" style="margin-top:24px">
    {updated && <><T k="dataChecked" /> {updated}. </>}
    {minutes[0] && <><T k="latestMinutes" />: {fmtDate(minutes[0].date)}. </>}
    <T k="updateWeekly" />
  </p>

  <div class="stats">
    <a class="stat" href={url('alueet')}><strong>{enabled.length}/21</strong><span><T k="regionsCount" /></span></a>
    <a class="stat" href={url('kokoukset')}><strong>{fi(meetings.length)}</strong><span><T k="meetingsCount" /></span></a>
    <div class="stat"><strong>{fi(items)}</strong><span><T k="itemsCount" /></span></div>
    <a class="stat" href={url('aanestykset')}><strong>{fi(allVotes.length)}</strong><span><T k="votesCount" /></span></a>
    <div class="stat"><strong>{fi(bodyCount)}</strong><span><T k="bodiesCount" /></span></div>
  </div>

  {allVotes.length > 0 && (
    <>
      <div class="section-head"><h2><T k="latestVotes" /></h2><a href={url('aanestykset')}><T k="allVotes" /> →</a></div>
      <VoteTable votes={allVotes.slice(0, 8)} showRegion />
    </>
  )}

  {upcoming.length > 0 && (
    <>
      <div class="section-head"><h2><T k="upcoming" /></h2><a href={`${url('kokoukset')}?stage=agenda`}><T k="showAll" /> →</a></div>
      <MeetingTable meetings={upcoming} showRegion />
    </>
  )}

  <div class="section-head"><h2><T k="latestMeetings" /></h2><a href={url('kokoukset')}><T k="showAll" /> →</a></div>
  <MeetingTable meetings={minutes.slice(0, 10)} showRegion />

  <div class="section-head"><h2><T k="regions" /></h2><a href={url('alueet')}><T k="showAll" /> →</a></div>
  <div class="grid">
    {enabled.map((r) => (
      <a class="card region-card" href={url(r.id)}>
        <span class="name"><L fi={r.short.fi!} sv={r.short.sv} /></span>
        <span class="meta">{fi(r.meetings)} <T k="meetingsCount" /></span>
      </a>
    ))}
  </div>

  <h2><T k="howTitle" /></h2>
  <ol class="how">
    <li><T k="how1" /></li>
    <li><T k="how2" /></li>
    <li><T k="how3" /></li>
  </ol>
</Layout>
