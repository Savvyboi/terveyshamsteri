---
import Layout from '../layouts/Layout.astro';
import T from '../components/T.astro';
import L from '../components/L.astro';
import { financeRows, populationSource, regionById, url } from '../lib/data';
import { eur, meur, seur, smeur, tone } from '../lib/fmt';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const rows = financeRows();
const year = Math.max(0, ...rows.map((r) => r.year));
const sum = (k: keyof (typeof rows)[number]) => rows.reduce((a, r) => a + ((r[k] as number) ?? 0), 0);
const pop = sum('population');
const deficit = rows.filter((r) => (r.cumulative_surplus ?? 0) < 0).length;
const bars = [...rows].filter((r) => r.cumulative_per_resident != null).sort((a, b) => a.cumulative_per_resident! - b.cumulative_per_resident!);
const maxAbs = Math.max(1, ...bars.map((r) => Math.abs(r.cumulative_per_resident!)));
const sortedRows = [...rows].sort((a, b) => (a.cumulative_per_resident ?? 0) - (b.cumulative_per_resident ?? 0));
---
<Layout title="Talous">
  <div class="page-head">
    <p class="kicker"><T k="kicker" /></p>
    <h1><T k="financesTitle" /></h1>
    <p class="lead"><T k="financesLead" /></p>
    <p class="note"><a href="https://www.tutkihallintoa.fi/hyvinvointialueiden-talous/"><T k="source_treasury" /> ↗</a> · <a href={populationSource()}><T k="source_population" /> ↗</a> · <a href={url('data/finances.json')}>JSON</a></p>
  </div>
  {rows.length === 0 ? <p><T k="noFinances" /></p> : (
    <>
      <div class="stats" style="margin-top:0">
        <div class="stat"><strong>{meur(sum('expenses'))}</strong><span><T k="fin_expenses" /> {year}</span></div>
        <div class="stat"><strong>{meur(sum('state_funding'))}</strong><span><T k="fin_state_funding" /> {year}</span></div>
        <div class="stat"><strong class={tone(sum('surplus'))}>{smeur(sum('surplus'))}</strong><span><T k="fin_surplus" /> {year}</span></div>
        <div class="stat"><strong class={tone(sum('cumulative_surplus'))}>{smeur(sum('cumulative_surplus'))}</strong><span><T k="fin_cumulative_surplus" /> · {deficit}/{rows.length} <T k="deficitCounties" /></span></div>
        <div class="stat"><strong>{eur(sum('expenses') / pop)}</strong><span><T k="fin_expenses" />, <T k="perResident" /></span></div>
      </div>

      <h2><T k="cumulativePerResident" /> 31.12.{year}</h2>
      <ul class="hbars">
        {bars.map((r) => {
          const v = r.cumulative_per_resident!;
          const w = `${Math.round((Math.abs(v) / maxAbs) * 100)}%`;
          const reg = regionById(r.region);
          return (
            <li>
              <a href={r.url}><L fi={reg.short.fi!} sv={reg.short.sv} /></a>
              <span class="hb-neg">{v < 0 && <span style={`width:${w}`}></span>}</span>
              <span class="hb-pos">{v > 0 && <span style={`width:${w}`}></span>}</span>
              <span class:list={['hb-val', tone(v)]}>{seur(v)}</span>
            </li>
          );
        })}
      </ul>

      <h2><T k="financeTable" /></h2>
      <p class="note"><T k="sortHint" /></p>
      <div class="table-wrap scroll">
        <table class="data sortable" id="fin-compare">
          <thead>
            <tr>
              <th data-sort="text"><T k="region" /></th>
              <th class="num" data-sort="num"><T k="residents" /></th>
              <th class="num" data-sort="num"><T k="fin_expenses" /><span class="sub"><T k="perResident" /></span></th>
              <th class="num" data-sort="num"><T k="fin_surplus" /> {year}</th>
              <th class="num" data-sort="num" aria-sort="ascending"><T k="fin_cumulative_surplus" /><span class="sub"><T k="perResident" /></span></th>
              <th class="num" data-sort="num"><T k="col_forecast" /> {year + 1}</th>
              <th class="num" data-sort="num"><T k="fin_loans" /><span class="sub"><T k="perResident" /></span></th>
            </tr>
          </thead>
          <tbody>
            {sortedRows.map((r) => {
              const reg = regionById(r.region);
              return (
                <tr>
                  <td data-v={r.name}><a class="t" href={r.url}><L fi={reg.short.fi!} sv={reg.short.sv} /></a></td>
                  <td class="num" data-v={r.population ?? ''}>{r.population?.toLocaleString('fi-FI') ?? '–'}</td>
                  <td class="num" data-v={r.expenses_per_resident ?? ''}>{eur(r.expenses_per_resident)}</td>
                  <td class:list={['num', tone(r.surplus)]} data-v={r.surplus ?? ''}>{smeur(r.surplus)}</td>
                  <td class:list={['num', tone(r.cumulative_surplus)]} data-v={r.cumulative_per_resident ?? ''}>{seur(r.cumulative_per_resident)}<span class="sub">{smeur(r.cumulative_surplus)}</span></td>
                  <td class:list={['num', tone(r.forecast_surplus)]} data-v={r.forecast_surplus ?? ''}>{smeur(r.forecast_surplus)}</td>
                  <td class="num" data-v={r.loans_per_resident ?? ''}>{eur(r.loans_per_resident)}</td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
      <p class="note" style="max-width:52rem"><T k="finNote" /></p>
    </>
  )}
  <script is:inline src={`${base}/sort.js`} defer></script>
</Layout>
