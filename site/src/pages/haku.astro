---
import Layout from '../layouts/Layout.astro';
import T from '../components/T.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
---
<Layout title="Haku">
  <Breadcrumbs trail={[{ fi: 'Haku', sv: 'Sök', en: 'Search' }]} />
  <div class="page-head">
    <p class="kicker"><T k="kicker" /></p>
    <h1><T k="searchTitle" /></h1>
    <p class="lead"><T k="searchLead" /></p>
  </div>
  <div id="search" class="pf"></div>
  <noscript>Haku vaatii JavaScriptin. / Sökningen kräver JavaScript.</noscript>
  <script is:inline>
    function start() {
      window.THsearch('#search').then(function (ui) {
        var params = new URLSearchParams(location.search);
        if (params.get('q')) ui.triggerSearch(params.get('q'));
        var f = {};
        if (params.get('region')) f.Alue = [params.get('region')];
        if (params.get('body')) f.Toimielin = [params.get('body')];
        if (Object.keys(f).length) ui.triggerFilters(f);
      });
    }
    if (window.THsearch) start(); else window.addEventListener('DOMContentLoaded', start);
    document.addEventListener('langchange', start);
  </script>
</Layout>
