---
import Layout from '../../layouts/Layout.astro';
import T from '../../components/T.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import MeetingRow from '../../components/MeetingRow.astro';
import VoteBar from '../../components/VoteBar.astro';
import { bodiesOf, fmtDate, itemUrl, load, meetingsOf, url, votesOf, type Region } from '../../lib/data';

export function getStaticPaths() {
  return load().regions.map((r) => ({ params: { region: r.id }, props: { r } }));
}
const { r } = Astro.props as { r: Region };
const meetings = meetingsOf(r.id);
const bodies = bodiesOf(r.id);
const types = ['council', 'board', 'committee', 'section', 'advisory', 'other'] as const;
const votes = votesOf(r.id).slice(0, 5);
const items = meetings.reduce((a, m) => a + m.items.length, 0);
const countBy = (b: string) => meetings.filter((m) => m.body_id === b).length;
const lastOf = (b: string) => meetings.find((m) => m.body_id === b)?.date;
---
<Layout title={r.name.fi}>
  <Breadcrumbs trail={[{ fi: r.short.fi, sv: r.short.sv }]} />
  <div class="page-head">
    <h1><span class="fi">{r.name.fi}</span><span class="sv">{r.name.sv}</span></h1>
    <p class="facts">
      <span><b>{meetings.length}</b> <T k="meetingsCount" /></span>
      <span><b>{items}</b> <T k="itemsCount" /></span>
      <span><b>{votesOf(r.id).length}</b> <T k="votesCount" /></span>
    </p>
    <div class="actions">
      <a class="btn small" href={`${url('haku')}?region=${encodeURIComponent(r.short.fi ?? r.id)}`}><T k="search" /></a>
      <a class="btn small secondary" href={url(r.id, 'henkilot')}><T k="people" /></a>
      <a class="btn small secondary" href={url(r.id, 'aanestykset')}><T k="votes" /></a>
    </div>
  </div>

  {meetings.length === 0 ? (
    <div class="card">
      <p><T k="noData" /></p>
      {r.notes?.fi && <p class="note">{r.notes.fi}</p>}
      {r.status?.errors?.length ? <p class="note">{r.status.errors[0]}</p> : null}
    </div>
  ) : (
    <div class="columns">
      <div>
        <h2><T k="bodies" /></h2>
        {types.map((t) => {
          const bs = bodies.filter((b) => b.type === t);
          return bs.length > 0 && (
            <>
              <h3><T k={`type_${t}`} /></h3>
              <ul class="list">
                {bs.map((b) => (
                  <li><a class="row" href={url(r.id, b.id)}>
                    <span class="title">{b.name}</span>
                    <span class="side">{countBy(b.id)} <T k="meetingsCount" /> · {fmtDate(lastOf(b.id)!)}</span>
                  </a></li>
                ))}
              </ul>
            </>
          );
        })}
        <h2><T k="latestMeetings" /></h2>
        <ul class="list">{meetings.slice(0, 12).map((m) => <MeetingRow m={m} />)}</ul>
      </div>
      <aside class="aside">
        {votes.length > 0 && (
          <div class="card">
            <h3 style="margin-top:0"><T k="latestVotes" /></h3>
            {votes.map(({ m, i, v }) => (
              <div style="margin-bottom:14px">
                <a href={itemUrl(m, i)}>{m.items[i].title}</a>
                <div class="note">{m.body_name} · {fmtDate(m.date)}</div>
                <VoteBar vote={v} compact />
              </div>
            ))}
            <a href={url(r.id, 'aanestykset')}><T k="allVotes" /> →</a>
          </div>
        )}
        <div class="card">
          <h3 style="margin-top:0"><T k="sources" /></h3>
          <dl class="kv">
            {r.sources.map((s) => (<><dt>{s.platform}</dt><dd><a href={s.url}>{new URL(s.url).host}</a>{s.valid_to && <> (– {fmtDate(s.valid_to)})</>}</dd></>))}
            {r.homepage && <><dt>www</dt><dd><a href={r.homepage}>{new URL(r.homepage).host}</a></dd></>}
            {r.status?.finished_at && <><dt><T k="lastUpdated" /></dt><dd>{new Date(r.status.finished_at).toLocaleDateString('fi-FI')}</dd></>}
          </dl>
          {r.since && <p class="note">Arkisto alkaen {fmtDate(r.since)} / Arkiv från {fmtDate(r.since)}</p>}
        </div>
      </aside>
    </div>
  )}
</Layout>
