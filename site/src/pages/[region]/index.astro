---
import Layout from '../../layouts/Layout.astro';
import T from '../../components/T.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import L from '../../components/L.astro';
import MeetingTable from '../../components/MeetingTable.astro';
import VoteTable from '../../components/VoteTable.astro';
import SeatBar from '../../components/SeatBar.astro';
import { BODY_TYPES, bodiesOf, electionOf, fmtDate, load, meetingsOf, url, votesOf, type Region } from '../../lib/data';

export function getStaticPaths() {
  return load().regions.map((r) => ({ params: { region: r.id }, props: { r } }));
}
const { r } = Astro.props as { r: Region };
const meetings = meetingsOf(r.id);
const bodies = bodiesOf(r.id);
const allVotes = votesOf(r.id);
const election = electionOf(r.id);
const items = meetings.reduce((a, m) => a + m.items.length, 0);
const countBy = (b: string) => meetings.filter((m) => m.body_id === b).length;
const lastOf = (b: string) => meetings.find((m) => m.body_id === b)?.date;
---
<Layout title={r.name.fi}>
  <Breadcrumbs trail={[{ href: url('alueet'), fi: 'Hyvinvointialueet', sv: 'Välfärdsområden', en: 'Counties' }, { fi: r.short.fi!, sv: r.short.sv }]} />
  <div class="page-head">
    <p class="kicker"><T k="kicker" /></p>
    <h1><L fi={r.name.fi!} sv={r.name.sv} en={r.name.en} /></h1>
    <p class="facts">
      <span><b>{meetings.length}</b> <T k="meetingsCount" /></span>
      <span><b>{items}</b> <T k="itemsCount" /></span>
      <span><b>{allVotes.length}</b> <T k="votesCount" /></span>
    </p>
    <div class="actions">
      <a class="btn small" href={`${url('haku')}?region=${encodeURIComponent(r.short.fi ?? r.id)}`}><T k="search" /></a>
      <a class="btn small secondary" href={url(r.id, 'valtuutetut')}><T k="councillors" /></a>
      <a class="btn small secondary" href={url(r.id, 'henkilot')}><T k="people" /></a>
      <a class="btn small secondary" href={url(r.id, 'aanestykset')}><T k="votes" /></a>
    </div>
  </div>

  {meetings.length === 0 ? (
    <>
    <div class="card">
      <p><T k="noData" /></p>
      {r.notes?.fi && <p class="note">{r.notes.fi}</p>}
      {r.status?.errors?.length ? <p class="note">{r.status.errors[0]}</p> : null}
    </div>
    {election && (
      <div class="card" style="margin-top:16px">
        <h3 style="margin-top:0"><T k="councillors" /> ({election.seats})</h3>
        <SeatBar parties={election.parties} />
        <p style="margin:12px 0 0"><a href={url(r.id, 'valtuutetut')}><T k="showAll" /> →</a></p>
      </div>
    )}
    </>
  ) : (
    <div class="columns">
      <div>
        <h2 style="margin-top:0"><T k="bodies" /></h2>
        {BODY_TYPES.map((t) => {
          const bs = bodies.filter((b) => b.type === t);
          return bs.length > 0 && (
            <>
              <h3><T k={`type_${t}`} /></h3>
              <ul class="list">
                {bs.map((b) => (
                  <li><a class="row" href={url(r.id, b.id)}>
                    <span class="title">{b.name}</span>
                    <span class="side">{countBy(b.id)} <T k="meetingsCount" /> · {fmtDate(lastOf(b.id)!)}</span>
                  </a></li>
                ))}
              </ul>
            </>
          );
        })}
        {allVotes.length > 0 && (
          <>
            <div class="section-head"><h2><T k="latestVotes" /></h2><a href={url(r.id, 'aanestykset')}><T k="allVotes" /> →</a></div>
            <VoteTable votes={allVotes.slice(0, 5)} />
          </>
        )}
        <div class="section-head"><h2><T k="latestMeetings" /></h2><a href={`${url('kokoukset')}?region=${r.id}`}><T k="showAll" /> →</a></div>
        <MeetingTable meetings={meetings.slice(0, 12)} />
      </div>
      <aside class="aside">
        {election && (
          <div class="card">
            <h3 style="margin-top:0"><T k="councillors" /> ({election.seats})</h3>
            <SeatBar parties={election.parties} />
            <p style="margin:12px 0 0"><a href={url(r.id, 'valtuutetut')}><T k="showAll" /> →</a></p>
          </div>
        )}
        <div class="card">
          <h3 style="margin-top:0"><T k="sources" /></h3>
          <dl class="kv">
            {r.sources.map((s) => (<><dt>{s.platform}</dt><dd><a href={s.url}>{new URL(s.url).host}</a>{s.valid_to && <> (– {fmtDate(s.valid_to)})</>}</dd></>))}
            {r.homepage && <><dt>www</dt><dd><a href={r.homepage}>{new URL(r.homepage).host}</a></dd></>}
            {r.status?.finished_at && <><dt><T k="lastUpdated" /></dt><dd>{new Date(r.status.finished_at).toLocaleDateString('fi-FI')}</dd></>}
          </dl>
          {r.since && <p class="note"><L fi={`Arkisto alkaen ${fmtDate(r.since)}`} sv={`Arkiv från ${fmtDate(r.since)}`} en={`Archive from ${fmtDate(r.since)}`} /></p>}
        </div>
      </aside>
    </div>
  )}
</Layout>
