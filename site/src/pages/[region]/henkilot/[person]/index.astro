---
import Layout from '../../../../layouts/Layout.astro';
import T from '../../../../components/T.astro';
import L from '../../../../components/L.astro';
import PartyTag from '../../../../components/PartyTag.astro';
import Breadcrumbs from '../../../../components/Breadcrumbs.astro';
import { bodyById, electionOf, fmtDate, load, meetingUrl, peopleOf, url, type PersonStats, type Region } from '../../../../lib/data';

export function getStaticPaths() {
  return load().regions.flatMap((r) => peopleOf(r.id).map((p) => ({ params: { region: r.id, person: p.slug }, props: { r, p } })));
}
const { r, p } = Astro.props as { r: Region; p: PersonStats };
const rate = (x: { present: number; absent: number }) => Math.round((x.present / Math.max(1, x.present + x.absent)) * 100);
const c = p.elected;
const e = electionOf(r.id);
const rank = c && e ? e.people.filter((x) => x.party === c.party && x.status === c.status && (x.votes ?? 0) > (c.votes ?? 0)).length + 1 : null;
const councilTotal = p.council.present + p.council.absent;
---
<Layout title={`${p.name} – ${r.short.fi}`}>
  <Breadcrumbs trail={[
    { href: url(r.id), fi: r.short.fi!, sv: r.short.sv },
    c ? { href: url(r.id, 'valtuutetut'), fi: 'Valtuutetut', sv: 'Ledamöter', en: 'Councillors' } : { href: url(r.id, 'henkilot'), fi: 'Henkilöt', sv: 'Personer', en: 'People' },
    { label: p.name },
  ]} />
  <div class="page-head">
    <p class="kicker"><L fi={r.name.fi!} sv={r.name.sv} en={r.name.en} /></p>
    <h1>{p.name}</h1>
    {p.roles.size > 0 && <p class="facts"><span><T k="roles" />: <b>{[...p.roles].slice(0, 6).join(', ')}</b></span></p>}
  </div>

  {c && (
    <dl class="profile">
      <div><dt><T k="party" /></dt><dd><PartyTag party={c.party} full /></dd></div>
      <div><dt><T k="status" /></dt><dd style="font-size:1.15rem"><T k={c.status === 'elected' ? 'st_elected' : 'st_deputy'} /></dd></div>
      <div><dt><T k="electionVotes" /></dt><dd>{c.votes?.toLocaleString('fi-FI') ?? '–'}</dd>
        {rank && <p class="note" style="margin:2px 0 0">#{rank} {c.party}{c.incumbent && <> · <T k="incumbent" /></>}</p>}</div>
      <div><dt><T k="councilAttendance" /></dt><dd>{councilTotal ? `${rate(p.council)} %` : '–'}</dd>
        {councilTotal > 0 && <p class="note" style="margin:2px 0 0">{p.council.present}/{councilTotal}</p>}</div>
    </dl>
  )}

  <div class="columns">
    <div>
      <h2 style="margin-top:0"><T k="meetings" /> ({p.meetings.length})</h2>
      {p.meetings.length === 0 ? <p class="note"><T k="noMinutesYet" /></p> : (
        <ul class="list">
          {p.meetings.map(({ m, group, role }) => (
            <li><a class="row" href={meetingUrl(m)}>
              <span class="date">{fmtDate(m.date)}</span>
              <span class="title">{m.body_name}{role && <span class="sub">{role}</span>}</span>
              <span class="side">{group === 'absent' ? <span class="chip warn"><T k="absent" /></span> : <span class="chip"><T k="present" /></span>}</span>
            </a></li>
          ))}
        </ul>
      )}
    </div>
    <aside class="aside">
      {p.bodies.size > 0 && (
        <div class="card">
          <h3 style="margin-top:0"><T k="attendance" /></h3>
          <ul class="list" style="border:0">
            {[...p.bodies.entries()].map(([b, s]) => (
              <li class="row" style="flex-direction:column;gap:4px;padding:10px 0">
                <a href={url(r.id, b)}>{bodyById(r.id, b).name}</a>
                <span style="display:flex;align-items:center;gap:8px;width:100%">
                  <span class="meter" style="flex:1"><span style={`width:${rate(s)}%`}></span></span>
                  <span class="note">{s.present}/{s.present + s.absent}</span>
                </span>
              </li>
            ))}
          </ul>
        </div>
      )}
      {c && e && (
        <div class="card">
          <h3 style="margin-top:0"><T k="sources" /></h3>
          <p class="note" style="margin:0"><a href={e.source}><T k="source_statfin" /> ↗</a></p>
        </div>
      )}
    </aside>
  </div>
</Layout>
