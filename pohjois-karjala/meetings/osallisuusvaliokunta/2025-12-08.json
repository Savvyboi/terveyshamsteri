  {
   "number": "32",
   "title": "Hyvinvointialuestrategia",
   "source_url": "https://dynastyjulkaisu.pohjoiskarjala.net/VateJulk/cgi/DREQUEST.PHP?page=meetingitem&id=2025100720-4",
   "pdf_url": "https://dynastyjulkaisu.pohjoiskarjala.net/VateJulk/kokous/2025100720-4.PDF",
   "diary_number": "7430/00.02.02/2025",
   "preparer": "Kumppanuuspäällikkö Maarita Mannelin; sähköposti:",
   "presenter": null,
   "proposal": null,
   "decision": null,
   "discussion": "Osallisuusvaliokunnalle kerrottiin alustavia suunnitelmia strategiatyön asukas- ja henkilöstöosallisuuden valmistelemisesta. Suunnitelmat tarkentuvat joulukuun tulevaisuuslautakunnan kokouksen jälkeen.",
   "sections": [
    {
     "heading": "Lisätiedot",
     "text": "Kumppanuuspäällikkö Maarita Mannelin\n\nsähköposti:"
    },
    {
     "heading": "Käsittely",
     "text": "Osallisuusvaliokunnalle kerrottiin alustavia suunnitelmia strategiatyön asukas- ja henkilöstöosallisuuden valmistelemisesta. Suunnitelmat tarkentuvat joulukuun tulevaisuuslautakunnan kokouksen jälkeen."
    },
    {
     "heading": "Selostus",
     "text": "Keskustellaan hyvinvointialuestrategian asukas – ja henkilöstöosallisuudesta."
    }
