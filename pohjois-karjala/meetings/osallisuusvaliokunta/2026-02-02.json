  {
   "number": "5",
   "title": "Osallisuus- ja yhdenvertaisuusohjelma",
   "source_url": "https://dynastyjulkaisu.pohjoiskarjala.net/VateJulk/cgi/DREQUEST.PHP?page=meetingitem&id=2026100754-5",
   "pdf_url": "https://dynastyjulkaisu.pohjoiskarjala.net/VateJulk/kokous/2026100754-5.PDF",
   "diary_number": "254/00.02.02/2026",
   "preparer": "Kumppanuuspäällikkö Maarita Mannelin; sähköposti:",
   "presenter": null,
   "proposal": null,
   "decision": null,
   "discussion": "Käytiin läpi ohjelmakokonaisuuden valmistelun tilannetta.",
   "sections": [
    {
     "heading": "Lisätiedot",
     "text": "Kumppanuuspäällikkö Maarita Mannelin\n\nsähköposti:"
    },
    {
     "heading": "Käsittely",
     "text": "Käytiin läpi ohjelmakokonaisuuden valmistelun tilannetta."
    },
    {
     "heading": "Selostus",
     "text": "Osallisuus- ja yhdenvertaisuusohjelman valmistelutyöryhmä kokoontui tammikuussa. Työryhmä keskusteli alustavasti osallisuus- ja yhdenvertaisuusohjelman laajuudesta sekä teki vertailua toisten hyvinvointialueiden vastaaviin ohjelmiin. Osallisuuteen liittyviä väittämiä tullaan sisällyttämään asukkaiden aluestrategian Voxit-keskusteluun."
    }
   ],
