  {
   "number": "3",
   "title": "Pohjois-Karjalan hyvinvointialueen järjestöjen toiminta-avustukset 2026",
   "source_url": "https://dynastyjulkaisu.pohjoiskarjala.net/VateJulk/cgi/DREQUEST.PHP?page=meetingitem&id=2026100754-3",
   "pdf_url": "https://dynastyjulkaisu.pohjoiskarjala.net/VateJulk/kokous/2026100754-3.PDF",
   "diary_number": "254/00.02.02/2026",
   "preparer": "Osallisuus- ja järjestöasiantuntija Minna Patama; sähköposti:",
   "presenter": null,
   "proposal": null,
   "decision": null,
   "discussion": "Merkittiin tiedoksi.",
   "sections": [
    {
     "heading": "Lisätiedot",
     "text": "Osallisuus- ja järjestöasiantuntija Minna Patama\n\nsähköposti:"
    },
    {
     "heading": "Käsittely",
     "text": "Merkittiin tiedoksi."
    },
    {
     "heading": "Selostus",
     "text": "Katsaus hyvinvointialueen myöntämiin vuoden 2026 järjestöjen toiminta-avustuksiin. Järjestöjen toiminta-avustusten hakuaika oli 10.11.-8.12.2025. Määräaikaan mennessä avustushakemuksia saapui 134 kpl. Haettujen avustusten yhteissumma on 537 838,64 €. Hyvinvoinnin ja terveyden edistämisen lautakunta on tehnyt päätöksen järjestöjen toiminta-avustuksista vuodelle 2026 21.1.2026 kokouksessaan (§ 8)."
    }
   ],
   "attachments": [
