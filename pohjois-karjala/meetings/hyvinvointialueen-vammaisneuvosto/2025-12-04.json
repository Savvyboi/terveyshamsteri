  {
   "number": "50",
   "title": "Kokouksen järjestäytyminen",
   "source_url": "https://dynastyjulkaisu.pohjoiskarjala.net/VateJulk/cgi/DREQUEST.PHP?page=meetingitem&id=2025100740-2",
   "pdf_url": "https://dynastyjulkaisu.pohjoiskarjala.net/VateJulk/kokous/2025100740-2.PDF",
   "diary_number": null,
   "preparer": null,
   "presenter": null,
   "proposal": null,
   "decision": null,
   "discussion": "Todettiin. Hyväksyttiin. Myönnettiin.\n\nKäytiin läpi kokouskäytännöt käsittelyehdotuksen mukaisesti.",
   "sections": [
    {
     "heading": "",
     "text": "Käsittelyehdotus\nTodetaan kokouksen läsnäolijat ja hyväksytään asialista. Myönnetään kokoukseen läsnäolo- ja puheoikeus suunnittelija Marjut Salmelalle.\n\nKäydään läpi yleiset kokouskäytännöt."
    },
    {
     "heading": "Käsittely",
     "text": "Todettiin. Hyväksyttiin. Myönnettiin.\n\nKäytiin läpi kokouskäytännöt käsittelyehdotuksen mukaisesti."
    }
   ],
