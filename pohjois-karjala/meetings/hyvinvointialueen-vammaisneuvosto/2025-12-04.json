  {
   "number": "51",
   "title": "Vammaisneuvoston toimintasäännön päivitys",
   "source_url": "https://dynastyjulkaisu.pohjoiskarjala.net/VateJulk/cgi/DREQUEST.PHP?page=meetingitem&id=2025100740-3",
   "pdf_url": "https://dynastyjulkaisu.pohjoiskarjala.net/VateJulk/kokous/2025100740-3.PDF",
   "diary_number": "8605/00.02.02/2025",
   "preparer": "Kumppanuuspäällikkö Maarita Mannelin; sähköposti:",
   "presenter": null,
   "proposal": null,
   "decision": null,
   "discussion": "Vammaisneuvosto keskusteli toimintasäännöstä ja teki siihen seuraavat päivitykset:\n\n§ 7\n\nMuutettiin vammaisvaltuuston tilalle sana vammaisneuvosto\n\n§ 9\n\nPoistettiin maininta päätösvaltaisuudesta, koska kyseessä ei ole päättävä toimielin.\n\n§ 9\n\nPoistettiin maininta, että \"Kokous voi sopia äänestystavasta toisin\".\n\nVammaisneuvosto hyväksyi toimintasäännön edellä esitetyin muutoksin. Uusi toimintasääntö astui voimaan saman tien.",
   "sections": [
    {
     "heading": "Lisätiedot",
     "text": "Kumppanuuspäällikkö Maarita Mannelin\n\nsähköposti:"
    },
    {
     "heading": "Käsittely",
     "text": "Vammaisneuvosto keskusteli toimintasäännöstä ja teki siihen seuraavat päivitykset:\n\n§ 7\n\nMuutettiin vammaisvaltuuston tilalle sana vammaisneuvosto\n\n§ 9\n\nPoistettiin maininta päätösvaltaisuudesta, koska kyseessä ei ole päättävä toimielin.\n\n§ 9\n\nPoistettiin maininta, että \"Kokous voi sopia äänestystavasta toisin\".\n\nVammaisneuvosto hyväksyi toimintasäännön edellä esitetyin muutoksin. Uusi toimintasääntö astui voimaan saman tien."
    },
    {
     "heading": "Selostus",
     "text": "Vammaisneuvosto käy läpi voimassa olevan toimintasäännön ja tekee siihen tarvittaessa muutoksia. Toimintasääntö on hyväksytty vammaisneuvoston kokouksessa 21.8.2024 § 72."
    }
   ],
