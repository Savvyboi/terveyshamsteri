   "number": "40",
   "title": "Kokouksen laillisuus ja päätösvaltaisuus",
   "source_url": "https://pshva.oncloudos.com/cgi/DREQUEST.PHP?page=meetingitem&id=2026985-1",
   "pdf_url": "https://pshva.oncloudos.com/kokous/2026985-1.PDF",
   "diary_number": null,
   "preparer": null,
   "presenter": null,
   "proposal": "Todetaan kokous laillisesti koolle kutsutuksi ja päätösvaltaiseksi.\n\nKutsu kokoukseen on toimitettu sähköisen kokousjärjestelmän kautta. Kutsu on lähetetty Pohjois-Savon hyvinvointialueen hallintosäännön 164 §:n mukaisesti vähintään 4 päivää ennen kokousta.\n\nHyvinvointialuelain 108 §:n mukaisesti toimielin on päätösvaltainen, kun enemmän kuin puolet jäsenistä on läsnä.",
   "decision": "Todettiin kokous laillisesti koolle kutsutuksi ja päätösvaltaiseksi.",
   "discussion": null,
   "sections": [
    {
     "heading": "",
     "text": "Kokouksen laillisuus ja päätösvaltaisuus"
    },
    {
     "heading": "Päätös",
     "text": "Todettiin kokous laillisesti koolle kutsutuksi ja päätösvaltaiseksi."
    },
    {
     "heading": "Päätösehdotus",
     "text": "Todetaan kokous laillisesti koolle kutsutuksi ja päätösvaltaiseksi.\n\nKutsu kokoukseen on toimitettu sähköisen kokousjärjestelmän kautta. Kutsu on lähetetty Pohjois-Savon hyvinvointialueen hallintosäännön 164 §:n mukaisesti vähintään 4 päivää ennen kokousta.\n\nHyvinvointialuelain 108 §:n mukaisesti toimielin on päätösvaltainen, kun enemmän kuin puolet jäsenistä on läsnä."
    }
   ],
